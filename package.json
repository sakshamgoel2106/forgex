{
  "name": "forgex-ai-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "ForgeX AI — Multimodal GenAI Assistant for Industrial SOPs, Manuals & Expert Knowledge",
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=@forgex/web",
    "lint": "npm run lint --workspaces --if-present",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "keywords": [
    "industrial-ai",
    "rag",
    "multimodal",
    "sops",
    "engineering"
  ],
  "author": "ForgeX AI Engineering Team",
  "license": "UNLICENSED"
}
