# =============================================================================
# ForgeX AI — Environment Configuration Specification (Phase 1 Baseline)
# =============================================================================

# Server Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Security & CORS
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=super_secret_forgex_jwt_key_at_least_32_characters_long_min_change_me
JWT_EXPIRES_IN=15m

# Relational Database (PostgreSQL 16)
DATABASE_URL=postgresql://forgex_admin:forgex_dev_secret_2026@localhost:5432/forgex_db

# Asynchronous Task Broker (Redis 7 & BullMQ)
REDIS_URL=redis://localhost:6379

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Object Storage (S3-Compatible / MinIO)
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=forgex_minio_admin
S3_SECRET_ACCESS_KEY=forgex_minio_secret_2026
S3_BUCKET_NAME=forgex-documents
S3_FORCE_PATH_STYLE=true

# Inference Engine Configuration
# INFERENCE_MODE: 'local_ollama' (Private Enterprise Air-Gap) or 'saas_cloud' (Managed / Azure / OpenAI)
INFERENCE_MODE=local_ollama
INFERENCE_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_VISION_MODEL=llava

# Cloud Inference Credentials (Only used when INFERENCE_MODE=saas_cloud)
CLOUD_LLM_API_KEY=
CLOUD_LLM_ENDPOINT=
CLOUD_LLM_MODEL=gpt-4o

# Document Processing Worker Service
DOCUMENT_WORKER_URL=http://localhost:8000

# Plant Deployment Configuration
PLANT_SITE_CODE=PLANT-TX-04
AIR_GAPPED_MODE=false
