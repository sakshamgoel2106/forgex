# =============================================================================
# ForgeX AI — Comprehensive Environment Configuration Template
# =============================================================================
# Copy this file to .env and adjust variables for your target deployment:
# - Local Development: Defaults below work with local dev fallbacks.
# - Private Enterprise: See infra/env/.env.enterprise.example
# - Multi-Tenant Cloud SaaS: See infra/env/.env.saas.example
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Core Runtime & Server Settings
# -----------------------------------------------------------------------------
# Node environment: 'development', 'test', 'staging', or 'production'
NODE_ENV=development

# Deployment mode: 'local_dev', 'enterprise', or 'saas'
# - local_dev: Uses deterministic local inference and memory stores if services down.
# - enterprise: Enforces strict air-gap; external telemetry and cloud inference are forbidden.
# - saas: Multi-tenant cloud mode with quota enforcement and cloud IdP.
DEPLOYMENT_MODE=local_dev

# Network binding
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Cross-Origin Resource Sharing (comma-separated origins allowed in production)
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# 2. Authentication & Identity Provider (IdP)
# -----------------------------------------------------------------------------
# Auth Provider: 'local_dev', 'keycloak' (Enterprise), or 'supabase' (SaaS)
AUTH_PROVIDER=local_dev

# JWT Secret for token verification (Minimum 32 characters in production)
JWT_SECRET=super_secret_forgex_jwt_key_at_least_32_characters_long_min_change_me
JWT_EXPIRES_IN=15m

# Self-Hosted Keycloak (Used when AUTH_PROVIDER=keycloak)
KEYCLOAK_REALM_URL=http://localhost:8080/realms/forgex
KEYCLOAK_CLIENT_ID=forgex-api

# Hosted Supabase Auth (Used when AUTH_PROVIDER=supabase)
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your_supabase_jwt_signing_secret_here

# -----------------------------------------------------------------------------
# 3. Relational Database (PostgreSQL 16)
# -----------------------------------------------------------------------------
# PostgreSQL connection string. If omitted or unreachable in local_dev,
# the system safely falls back to InMemoryDataStore.
DATABASE_URL=postgresql://forgex_admin:forgex_dev_secret_2026@localhost:5432/forgex_db

# -----------------------------------------------------------------------------
# 4. Asynchronous Task Queue & Cache (Redis 7)
# -----------------------------------------------------------------------------
# Redis broker for BullMQ document processing and ingestion pipelines
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# 5. Multimodal Vector Database (Qdrant)
# -----------------------------------------------------------------------------
# Qdrant REST endpoint (Local container or Qdrant Cloud cluster)
QDRANT_URL=http://localhost:6333
# API key for Qdrant Cloud (Leave empty for unauthenticated local container)
QDRANT_API_KEY=
# Collection name for document chunks
QDRANT_COLLECTION=forgex_knowledge

# -----------------------------------------------------------------------------
# 6. Object Storage (S3-Compatible / MinIO)
# -----------------------------------------------------------------------------
# Storage provider: 's3' (MinIO / AWS S3) or 'local' (Local file vault)
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=forgex_minio_admin
S3_SECRET_ACCESS_KEY=forgex_minio_secret_2026
S3_BUCKET_NAME=forgex-documents
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# 7. AI Inference Engine & LLM Configuration
# -----------------------------------------------------------------------------
# Inference Mode: 'local_ollama' or 'saas_cloud'
INFERENCE_MODE=local_ollama

# Inference Provider: 'ollama', 'local', 'saas', 'cloud', 'openai', 'azure', or 'gemini'
INFERENCE_PROVIDER=ollama

# Local Ollama Configuration (Enterprise air-gapped / on-premises)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_VISION_MODEL=llava

# Cloud AI Provider Credentials (Used ONLY when DEPLOYMENT_MODE=saas and INFERENCE_PROVIDER=saas/cloud)
CLOUD_AI_API_KEY=
CLOUD_AI_MODEL=gpt-4o-industrial
CLOUD_AI_ENDPOINT=

# -----------------------------------------------------------------------------
# 8. Document Processing & OCR Worker Service
# -----------------------------------------------------------------------------
# Python / FastAPI layout analysis and OCR extraction worker
WORKER_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# 9. Industrial Facility Context & Privacy Controls
# -----------------------------------------------------------------------------
PLANT_SITE_CODE=PLANT-TX-04

# Strict Air-Gap Policy: When true, TELEMETRY_ENABLED must be false and cloud inference is forbidden
AIR_GAPPED_MODE=false
TELEMETRY_ENABLED=false

# -----------------------------------------------------------------------------
# 10. Rate Limiting & Usage Quotas
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX_PER_MINUTE=120
RATE_LIMIT_AI_PER_MINUTE=30
TENANT_QUOTA_QUERIES_MONTHLY=50000
TENANT_QUOTA_STORAGE_BYTES=107374182400

# -----------------------------------------------------------------------------
# 11. Voice Assistant & Production Speech Processing (Wake-Word, STT, TTS)
# -----------------------------------------------------------------------------
# Local wake-word trigger ("Hello ForgeX")
VOICE_WAKE_WORD_ENABLED=true
VOICE_WAKE_WORD_PHRASE="Hello ForgeX"
VOICE_WAKE_WORD_ENGINE=porcupine
VOICE_WAKE_WORD_MODEL_PATH=
PICOVOICE_ACCESS_KEY=

# Speech-to-Text: 'local' (deterministic), 'gemini' (SaaS cloud), or 'faster-whisper' (Enterprise)
VOICE_STT_PROVIDER=local

# Text-to-Speech: 'local' (deterministic), 'google' (SaaS neural), or 'piper' (Enterprise offline)
VOICE_TTS_PROVIDER=local

# Audio limits & VAD thresholds
VOICE_MAX_DURATION_SECONDS=120
VOICE_MAX_FILE_SIZE_MB=15
VOICE_SILENCE_TIMEOUT_MS=1000
VOICE_SESSION_IDLE_TIMEOUT_SECONDS=30

# Strict Offline Enforcement: Prevents any cloud audio transmission
VOICE_STRICT_OFFLINE=false

# -----------------------------------------------------------------------------
# 12. Google OAuth & Email Identity Verification (OTP)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-api-key-here
SMTP_FROM="ForgeX AI Security <noreply@yourdomain.com>"
ALLOW_DEMO_BOOTSTRAP=false

