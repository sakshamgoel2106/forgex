# ==============================================================================
# ForgeX AI — Air-Gapped On-Prem Enterprise Environment Configuration
# Mode: ENTERPRISE (Single-Tenant, Local Ollama AI, Local MinIO, No Google OAuth)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Deployment Mode & Architecture
# ------------------------------------------------------------------------------
# Set to 'enterprise' for single-tenant, on-prem, air-gapped facility deployment
DEPLOYMENT_MODE=enterprise

# Self-service organization registration is strictly locked once tenant org exists
ALLOW_ORG_SIGNUP=false

# Google OAuth and external identity providers are disabled (air-gapped compliance)
ALLOW_GOOGLE_AUTH=false

# Zero outbound internet access permitted (strictly air-gapped intranet)
ALLOW_EXTERNAL_NETWORK=false

# AI Inference Provider: 'ollama' | 'vllm' (local GPU / CPU inference)
AI_PROVIDER=ollama

# Local Vector Database Provider: 'qdrant-local'
VECTOR_PROVIDER=qdrant-local

# Local Object Storage Provider: 'minio'
STORAGE_PROVIDER=minio

# Optional: Hardcode the single tenant UUID or leave blank to auto-detect first org
SINGLE_TENANT_ORG_ID=

# ------------------------------------------------------------------------------
# 2. White-Label Facility Branding
# ------------------------------------------------------------------------------
BRANDING_NAME=Enterprise Industrial Workspace
BRANDING_LOGO_URL=/forgex_icon.png
BRANDING_PRIMARY_COLOR=#1e293b

# ------------------------------------------------------------------------------
# 3. Server & Networking
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
# Comma-separated list of allowed web & mobile origins.
# For Android APK / Capacitor native builds, always include: https://localhost, capacitor://localhost, http://localhost
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost,http://localhost
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost,http://localhost
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 4. Security, JWT & On-Prem Authentication
# ------------------------------------------------------------------------------
# Core JWT signature secret (at least 32 characters)
JWT_SECRET=enterprise_onprem_secure_jwt_secret_min_32_characters_long_key
JWT_EXPIRES_IN=12h

# Identity Provider: 'local_dev' (built-in in-memory / postgres auth) or 'keycloak' (enterprise SSO)
AUTH_PROVIDER=local_dev
KEYCLOAK_REALM_URL=
KEYCLOAK_CLIENT_ID=

# ------------------------------------------------------------------------------
# 5. Local On-Prem Database & Cache
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://forgex_admin:forgex_dev_secret_2026@localhost:5432/forgex_db
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 6. Local Qdrant Vector Database (Self-Hosted Docker)
# ------------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=forgex_industrial_knowledge

# ------------------------------------------------------------------------------
# 7. Local MinIO S3 Object Storage (Self-Hosted Docker)
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=forgex_minio_admin
S3_SECRET_ACCESS_KEY=forgex_minio_secret_2026
S3_BUCKET_NAME=forgex-documents
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 8. Local Ollama LLM / VLM Inference (GPU Server)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_VISION_MODEL=llava

# ------------------------------------------------------------------------------
# 9. Internal On-Prem Relay SMTP (Optional)
# ------------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM=system@plant.internal
