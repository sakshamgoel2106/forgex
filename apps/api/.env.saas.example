# ==============================================================================
# ForgeX AI — Cloud Multi-Tenant SaaS Environment Configuration
# Mode: SAAS (Multi-Tenant, Cloud AI, Public Self-Registration, Social OAuth)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Deployment Mode & Architecture
# ------------------------------------------------------------------------------
# Set to 'saas' for multi-tenant cloud operation
DEPLOYMENT_MODE=saas

# Allow new companies/organizations to self-register via web portal
ALLOW_ORG_SIGNUP=true

# Allow Google OAuth / Social identity authentication
ALLOW_GOOGLE_AUTH=true

# Allow outbound external internet access (Gemini API, Webhooks, S3)
ALLOW_EXTERNAL_NETWORK=true

# AI Inference Provider: 'gemini' | 'ollama' | 'vllm'
AI_PROVIDER=gemini

# Vector Database Provider: 'qdrant-cloud' | 'qdrant-local'
VECTOR_PROVIDER=qdrant-cloud

# Object Storage Provider: 's3' | 'minio'
STORAGE_PROVIDER=s3

# Leave empty for SaaS multi-tenancy (each org is dynamically resolved)
SINGLE_TENANT_ORG_ID=

# ------------------------------------------------------------------------------
# 2. White-Label Branding
# ------------------------------------------------------------------------------
BRANDING_NAME=ForgeX AI
BRANDING_LOGO_URL=/forgex_icon.png
BRANDING_PRIMARY_COLOR=#0f172a

# ------------------------------------------------------------------------------
# 3. Server & Networking
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
# Comma-separated list of allowed web & mobile origins.
# For Android APK / Capacitor native builds, always include: https://localhost, capacitor://localhost, http://localhost
ALLOWED_ORIGINS=https://app.forgex.ai,http://localhost:5173,https://localhost,capacitor://localhost,http://localhost
CORS_ORIGIN=https://app.forgex.ai,http://localhost:5173,https://localhost,capacitor://localhost,http://localhost
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 4. Security, JWT & Authentication
# ------------------------------------------------------------------------------
# Core JWT signature secret (at least 32 characters)
JWT_SECRET=production_strong_secret_key_change_me_in_production_min32chars
JWT_EXPIRES_IN=24h

# Identity Provider: 'supabase' | 'keycloak' | 'local_dev'
AUTH_PROVIDER=supabase
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 5. Cloud Database & Cache
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@cloud-postgres-host:5432/forgex_db
REDIS_URL=redis://default:password@cloud-redis-host:6379

# ------------------------------------------------------------------------------
# 6. Qdrant Cloud Vector Database
# ------------------------------------------------------------------------------
QDRANT_URL=https://your-cluster-id.qdrant.tech:6333
QDRANT_API_KEY=your-qdrant-cloud-api-key
QDRANT_COLLECTION=forgex_industrial_knowledge

# ------------------------------------------------------------------------------
# 7. Cloud Object Storage (AWS S3 or Compatible)
# ------------------------------------------------------------------------------
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-aws-access-key-id
S3_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET_NAME=forgex-documents
S3_FORCE_PATH_STYLE=false

# ------------------------------------------------------------------------------
# 8. Generative AI & Multimodal APIs
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
CLOUD_AI_API_KEY=your-gemini-or-openai-api-key
CLOUD_AI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 9. Email & Notifications (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@forgex.ai
